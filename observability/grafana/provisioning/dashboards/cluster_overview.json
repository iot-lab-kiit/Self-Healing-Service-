      "title": "MTTR per self-heal (s)",
      "description": "Time from pre-reboot handshake to ONLINE handshake",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "remediation_last_duration_seconds",
          "legendFormat": "{{machine_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
