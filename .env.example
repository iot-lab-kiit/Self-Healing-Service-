# Copy to .env to override defaults. Every variable is optional - docker-compose.yml has the same defaults.

# Traefik image. The spec targets v3.0, but Docker Engine 29+ rejects the old API client
# bundled in v3.0 ("client version 1.24 is too old"), so the default is a newer v3 release.
# TRAEFIK_IMAGE=traefik:v3.0
TRAEFIK_IMAGE=traefik:v3.6

# machine-node: report simulated GPU load (8-15% baseline, spikes via /fault/gpu).
# Keep "true" on machines without a dedicated Nvidia GPU.
SIMULATE_GPU=true

# remediation-engine
REMEDIATION_COOLDOWN_SECONDS=45
REBOOT_ETA_SECONDS=30

# Grafana (http://localhost:3000)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
