# Copy to server.env on the central server and fill in the real machine addresses.
MACHINE_1_IP=192.168.1.11
MACHINE_2_IP=192.168.1.12
MACHINE_3_IP=192.168.1.13
MACHINE_4_IP=192.168.1.14
MACHINE_5_IP=192.168.1.15

# Client certificates for each machine's Docker API live in ./certs/machine-N/{ca,cert,key}.pem
DOCKER_CERTS_DIR=./certs
DOCKER_HOSTS='{"machine-1":{"url":"tcp://machine-1:2376","certDir":"/certs/machine-1"},"machine-2":{"url":"tcp://machine-2:2376","certDir":"/certs/machine-2"},"machine-3":{"url":"tcp://machine-3:2376","certDir":"/certs/machine-3"},"machine-4":{"url":"tcp://machine-4:2376","certDir":"/certs/machine-4"},"machine-5":{"url":"tcp://machine-5:2376","certDir":"/certs/machine-5"}}'

GF_ADMIN_PASSWORD=change-me
